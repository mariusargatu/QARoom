{
  "consumer": {
    "name": "webhooks"
  },
  "messages": [
    {
      "contents": {
        "amount_cents": 2500,
        "community_id": "comm_00000000000000000000000000",
        "currency": "USD",
        "donation_id": "dntn_00000000000000000000000000",
        "donor_id": "user_00000000000000000000000000",
        "event_id": "evt_00000000000000000000000000",
        "occurred_at": "2026-06-03T00:00:00.000Z",
        "status": "Captured"
      },
      "description": "a donation state changed event",
      "matchingRules": {
        "body": {
          "$.amount_cents": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.community_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^comm_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            ]
          },
          "$.currency": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^[A-Z]{3}$"
              }
            ]
          },
          "$.donation_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^dntn_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            ]
          },
          "$.donor_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^user_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            ]
          },
          "$.event_id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            ]
          },
          "$.occurred_at": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.status": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        },
        "metadata": {
          "Nats-Msg-Id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            ]
          },
          "tenant.id": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^comm_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            ]
          }
        }
      },
      "metadata": {
        "Nats-Msg-Id": "evt_00000000000000000000000000",
        "contentType": "application/json",
        "event-name": "donation.state.changed",
        "event-version": "1",
        "tenant.id": "comm_00000000000000000000000000"
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "donations"
  }
}
    "@qaroom/messaging": "workspace:*",
    "@qaroom/otel": "workspace:*",
    "@qaroom/service-kit": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@pact-foundation/pact": "^17.1.4",
    "@fast-check/vitest": "catalog:",
    "@qaroom/content": "workspace:*",
    "@qaroom/testing-utils": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "drizzle-kit": "^0.31.11",
    "fast-check": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "catalog:",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1"
  }
